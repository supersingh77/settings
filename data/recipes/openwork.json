{
  "id": "openwork",
  "source": {
    "kind": "github",
    "repo": "different-ai/openwork",
    "asset": {
      "prefix": "openwork-linux-x86_64",
      "suffix": ".AppImage"
    }
  },
  "paths": {
    "install": "{home}/.local/lib/openwork",
    "version": "{home}/.local/bin/openwork.version",
    "launcher": "{home}/.local/bin/openwork",
    "desktop": "{home}/.local/share/applications/openwork.desktop",
    "icon": "{home}/.local/share/icons/hicolor/512x512/apps/openwork.png"
  },
  "install": {
    "kind": "appimage"
  },
  "launcher": {
    "env": [
      [
        "APPDIR",
        "{install}"
      ],
      [
        "PATH",
        "\"${APPDIR}:${APPDIR}/usr/sbin:${PATH}\""
      ],
      [
        "LD_LIBRARY_PATH",
        "\"${APPDIR}/usr/lib:${LD_LIBRARY_PATH}\""
      ],
      [
        "XDG_DATA_DIRS",
        "\"${APPDIR}/usr/share/:${XDG_DATA_DIRS}:/usr/share/gnome/:/usr/local/share/:/usr/share/\""
      ]
    ],
    "command": "{install}/openwork --no-sandbox"
  },
  "icon": {
    "kind": "file",
    "source": "{install}/.DirIcon"
  },
  "desktop": [
    [
      "Name",
      "OpenWork"
    ],
    [
      "Comment",
      "AI IDE"
    ],
    [
      "Exec",
      "{home}/.local/bin/openwork %U"
    ],
    [
      "Icon",
      "openwork"
    ],
    [
      "Terminal",
      "false"
    ],
    [
      "Type",
      "Application"
    ],
    [
      "Categories",
      "Development;IDE;"
    ],
    [
      "MimeType",
      "x-scheme-handler/openwork;"
    ]
  ]
}
