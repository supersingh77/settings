{
  "update": [
    {"name": "Flatpak applications", "argv": ["flatpak", "update", "-y"]},
    {"name": "Installed apps", "apps": "update"},
    {
      "name": "Toolbox packages",
      "toolbox": ["sudo", "dnf", "upgrade", "-y", "--refresh"]
    },
    {"name": "Host deployment", "argv": ["rpm-ostree", "upgrade"]}
  ],
  "cleanup": [
    {"name": "Btrfs scrub", "argv": ["sudo", "btrfs", "scrub", "start", "-B", "/var"]},
    {"name": "Unused Flatpak runtimes", "argv": ["flatpak", "uninstall", "--unused", "-y"]},
    {"name": "Old deployments", "argv": ["rpm-ostree", "cleanup", "-b"]},
    {
      "name": "Journal",
      "argv": ["journalctl", "--vacuum-time=2weeks", "--vacuum-size=64M"]
    },
    {"name": "DNS cache", "argv": ["resolvectl", "flush-caches"]},
    {"name": "Trash", "argv": ["gio", "trash", "--empty"]}
  ]
}
