SETTINGS_ROOT="${SETTINGS_ROOT:-$(git -C "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../../.." rev-parse --show-toplevel 2>/dev/null)}"
laptop() { PYTHONPATH="$SETTINGS_ROOT/device/fedora-laptop" python3 -m laptop "$@"; }
alias docs="cd '$SETTINGS_ROOT/device/fedora-laptop'"
alias update='laptop update'
alias cleanup='laptop cleanup'
alias uad='laptop uad'
